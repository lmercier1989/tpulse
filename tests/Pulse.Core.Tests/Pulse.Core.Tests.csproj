<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
    <!-- The interop layout tests take field offsets with pointer arithmetic. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(PulseWindows)' == 'true'">
    <Compile Remove="**/*.Linux.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PulseWindows)' != 'true'">
    <!-- The layouts of Windows structures, performance counters and other machines exist on Windows only. -->
    <Compile Remove="Interop/InteropLayoutTests.cs;Metrics/WatchCollectorTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pulse.Core\Pulse.Core.csproj" />
  </ItemGroup>

</Project>
