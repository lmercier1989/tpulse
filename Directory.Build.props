<Project>
  <PropertyGroup>
    <!-- Windows builds everything, the window included; elsewhere (Linux) only the terminal monitor. Override with
         -p:PulseWindows=true or false. -->
    <PulseWindows Condition="'$(PulseWindows)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</PulseWindows>
    <TargetFramework Condition="'$(PulseWindows)' == 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(PulseWindows)' != 'true'">net10.0</TargetFramework>
    <!-- Building the Windows variant on another OS needs the Windows targeting packs. -->
    <EnableWindowsTargeting Condition="'$(PulseWindows)' == 'true'">true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>Pulse</Product>
    <Copyright>Pulse contributors</Copyright>
  </PropertyGroup>
</Project>
