<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pulse.MainWindow"
        Title="Pulse"
        Width="720"
        MinWidth="340"
        MinHeight="120"
        SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
  <Grid x:Name="Root" Background="Transparent">
    <Grid x:Name="ChannelHost" Margin="16,10,16,14" />

    <TextBlock x:Name="EmptyHint" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Center"
               Classes="detail" IsVisible="False"
               Text="All graphs are hidden. Press 1 to 6 to show one." />

    <!-- The moment under the mouse: drawn in the window rather than as a popup, so it never steals the mouse. -->
    <Canvas x:Name="TipLayer" IsHitTestVisible="False">
      <Border x:Name="Tip" IsVisible="False" Background="#12151B" BorderBrush="#1A1E25" BorderThickness="1" Padding="10,8">
        <StackPanel>
          <TextBlock x:Name="TipText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#E4E8EE" />
          <TextBlock x:Name="TipHeld" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#8790A0" Margin="0,6,0,0"
                     Text="held · let go to follow the mouse" IsVisible="False" />
        </StackPanel>
      </Border>
    </Canvas>

    <Border x:Name="Toast" Margin="0,0,0,18" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="#EE12161D" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="5"
            IsHitTestVisible="False" Opacity="0">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Border.Transitions>
      <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <Border x:Name="HelpOverlay" Background="#F5090B0F" IsVisible="False" Cursor="Hand">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
          <TextBlock Margin="0,0,0,18" Classes="channelName" Text="KEYS, MOUSE AND MARKERS" />
          <WrapPanel x:Name="HelpGroups" MaxWidth="1180" />
          <TextBlock x:Name="HelpFooter" Margin="0,4,0,0" Classes="stat" TextWrapping="Wrap" MaxWidth="760" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
