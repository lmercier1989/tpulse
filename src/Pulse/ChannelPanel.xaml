<UserControl x:Class="Pulse.ChannelPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:Pulse.Rendering">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="Header" Height="26" Background="Transparent" Cursor="Hand">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Ellipse x:Name="Dot" Width="6" Height="6" Margin="1,0,8,0" VerticalAlignment="Center" />
      <TextBlock x:Name="NameText" Grid.Column="1" Style="{StaticResource ChannelNameText}" />
      <TextBlock x:Name="DetailText" Grid.Column="2" Margin="12,0,12,0" Style="{StaticResource DetailText}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="StatsText" Grid.Column="3" Margin="0,0,16,0" Style="{StaticResource StatText}" />

      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <Rectangle x:Name="PrimaryKey" Width="9" Height="2" Margin="0,1,6,0" VerticalAlignment="Center" />
        <TextBlock x:Name="PrimaryLabel" Style="{StaticResource ValueLabelText}" />
        <TextBlock x:Name="PrimaryValue" Style="{StaticResource ValueText}" />
        <Rectangle x:Name="SecondaryKey" Width="9" Height="2" Margin="16,1,6,0" VerticalAlignment="Center" />
        <TextBlock x:Name="SecondaryLabel" Style="{StaticResource ValueLabelText}" />
        <TextBlock x:Name="SecondaryValue" Style="{StaticResource ValueText}" />
      </StackPanel>
    </Grid>

    <Grid x:Name="PlotHost" Grid.Row="1" Background="Transparent">
      <rendering:ScopeView x:Name="Scope" />
      <TextBlock x:Name="ScaleText" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsHitTestVisible="False" Style="{StaticResource TickText}" />
      <TextBlock x:Name="MessageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" Style="{StaticResource StatText}" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
