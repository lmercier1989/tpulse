<Window x:Class="Pulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        Width="720"
        MinWidth="340"
        MinHeight="120"
        SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Grid x:Name="Root" Background="Transparent">
    <Grid x:Name="ChannelHost" Margin="16,10,16,14" />

    <TextBlock x:Name="EmptyHint" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Center"
               Style="{StaticResource DetailText}" Visibility="Collapsed"
               Text="All graphs are hidden. Press 1 to 6 to show one." />

    <Border x:Name="Toast" Margin="0,0,0,18" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="#EE12161D" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="5"
            IsHitTestVisible="False" Opacity="0">
      <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <Border x:Name="HelpOverlay" Background="#F5090B0F" Visibility="Collapsed" Cursor="Hand">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <TextBlock Margin="0,0,0,18" Style="{StaticResource ChannelNameText}" Text="KEYS, MOUSE AND MARKERS" />
        <WrapPanel x:Name="HelpGroups" MaxWidth="1180" />
        <TextBlock x:Name="HelpFooter" Margin="0,4,0,0" Style="{StaticResource StatText}" TextWrapping="Wrap" MaxWidth="760" />
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
